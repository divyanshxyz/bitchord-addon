PORT=3000
HOST=0.0.0.0
ADDON_ID=in.divyansh.bitchord-flac
ADDON_NAME="Lossless FLAC Master Library"
ADDON_VERSION=1.1.0

# Path to your local FLAC audio directory (default: ./music)
MUSIC_DIR=./music

# 1 = BitChord checks if phone is on wired/DAC/LDAC output before asking addon
# 0 = Always enabled even on phone speaker
CHECK_VALID_LOSSLESS=0

ALLOW_DOWNLOADS=1

# (Optional) Remote Navidrome / Subsonic server for streaming your FLAC collection
SUBSONIC_URL=
SUBSONIC_USER=
SUBSONIC_TOKEN=
